{
  "actorSpecification": 1,
  "name": "kazakhstan-company-lookup",
  "title": "Kazakhstan Company Lookup by BIN",
  "description": "Look up Kazakhstan legal entities by BIN (12-digit business identification number) or by name in official public sources: the state register of legal entities (data.egov.kz) and the Bureau of National Statistics (stat.gov.kz). Returns name, status, registration date, address, director, OKED activity, size (KRP) and KATO code. For KYB and compliance.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "defaultMemoryMbytes": 256,
  "minMemoryMbytes": 128,
  "maxMemoryMbytes": 1024,
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "fields": {},
      "views": {
        "overview": {
          "title": "Companies",
          "transformation": {
            "fields": [
              "found",
              "bin",
              "name",
              "legalFormCode",
              "statusCategory",
              "status",
              "registrationDate",
              "address",
              "director",
              "primaryActivity",
              "size",
              "katoCode",
              "matchedQuery",
              "lookupStatus",
              "error",
              "retrievedAt"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "found": {
                "label": "Found",
                "format": "boolean"
              },
              "bin": {
                "label": "BIN"
              },
              "name": {
                "label": "Name"
              },
              "legalFormCode": {
                "label": "Form"
              },
              "statusCategory": {
                "label": "Status"
              },
              "status": {
                "label": "Status (original)"
              },
              "registrationDate": {
                "label": "Registered",
                "format": "date"
              },
              "address": {
                "label": "Address"
              },
              "director": {
                "label": "Director"
              },
              "primaryActivity": {
                "label": "OKED activity",
                "format": "object"
              },
              "size": {
                "label": "Size (KRP)",
                "format": "object"
              },
              "katoCode": {
                "label": "KATO"
              },
              "matchedQuery": {
                "label": "Query"
              },
              "lookupStatus": {
                "label": "Lookup status"
              },
              "error": {
                "label": "Error"
              },
              "retrievedAt": {
                "label": "Retrieved",
                "format": "date"
              }
            }
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}