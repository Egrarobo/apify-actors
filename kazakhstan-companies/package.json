{
  "name": "kazakhstan-company-lookup",
  "version": "1.0.0",
  "description": "Look up Kazakhstan legal entities by BIN or name in official public sources: the Ministry of Justice state register on data.egov.kz and the Bureau of National Statistics (stat.gov.kz).",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "node src/main.js",
    "test": "node --test test/*.test.js",
    "validate-schema": "node scripts/validate-schema.js"
  },
  "keywords": [
    "kazakhstan",
    "bin",
    "company registry",
    "kyb",
    "egov.kz",
    "stat.gov.kz",
    "apify"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "apify": "^3.7.2",
    "got-scraping": "^4.2.1"
  },
  "devDependencies": {
    "@apify/input_schema": "^4.0.5",
    "ajv": "^8.20.0"
  }
}
