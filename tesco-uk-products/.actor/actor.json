{
  "actorSpecification": 1,
  "name": "tesco-uk-products",
  "title": "Tesco Scraper – UK Grocery Prices & Clubcard Prices",
  "description": "Scrape Tesco UK groceries by keyword, category or product: prices, Clubcard Prices, unit prices, offers, availability, images and IDs (TPNC/TPNB) in a clean format. Reads Tesco's product API, so it works without residential proxies in most runs; automatic retries and clear per-search errors.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "minMemoryMbytes": 512,
  "defaultMemoryMbytes": 1024,
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "fields": {},
      "views": {
        "overview": {
          "title": "Products",
          "transformation": {
            "fields": [
              "name",
              "size",
              "price",
              "loyaltyPrice",
              "unitPriceText",
              "isOnSpecial",
              "promoText",
              "inStock",
              "category",
              "searchTerm",
              "url",
              "imageUrl"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "name": {
                "label": "Product",
                "format": "text"
              },
              "size": {
                "label": "Size",
                "format": "text"
              },
              "price": {
                "label": "Price (GBP)",
                "format": "number"
              },
              "loyaltyPrice": {
                "label": "Clubcard Price",
                "format": "number"
              },
              "unitPriceText": {
                "label": "Unit price",
                "format": "text"
              },
              "isOnSpecial": {
                "label": "Special",
                "format": "boolean"
              },
              "promoText": {
                "label": "Promotion",
                "format": "text"
              },
              "inStock": {
                "label": "Available",
                "format": "boolean"
              },
              "category": {
                "label": "Category",
                "format": "text"
              },
              "searchTerm": {
                "label": "Search",
                "format": "text"
              },
              "url": {
                "label": "Link",
                "format": "link"
              },
              "imageUrl": {
                "label": "Image",
                "format": "image"
              }
            }
          }
        },
        "specials": {
          "title": "Offers & Clubcard Prices",
          "transformation": {
            "fields": [
              "name",
              "size",
              "price",
              "loyaltyPrice",
              "wasPrice",
              "savings",
              "promoType",
              "promoText",
              "promoEndDate",
              "unitPriceText",
              "url"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "name": {
                "label": "Product",
                "format": "text"
              },
              "size": {
                "label": "Size",
                "format": "text"
              },
              "price": {
                "label": "Price (GBP)",
                "format": "number"
              },
              "loyaltyPrice": {
                "label": "Clubcard Price",
                "format": "number"
              },
              "wasPrice": {
                "label": "Was",
                "format": "number"
              },
              "savings": {
                "label": "Saving",
                "format": "number"
              },
              "promoType": {
                "label": "Type",
                "format": "text"
              },
              "promoText": {
                "label": "Promotion",
                "format": "text"
              },
              "promoEndDate": {
                "label": "Offer ends",
                "format": "text"
              },
              "unitPriceText": {
                "label": "Unit price",
                "format": "text"
              },
              "url": {
                "label": "Link",
                "format": "link"
              }
            }
          }
        },
        "errors": {
          "title": "Errors",
          "transformation": {
            "fields": [
              "isError",
              "searchTerm",
              "categoryUrl",
              "productId",
              "error",
              "errorStep",
              "httpStatus",
              "blocked",
              "blockMarkers"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "isError": {
                "label": "Error row",
                "format": "boolean"
              },
              "searchTerm": {
                "label": "Search",
                "format": "text"
              },
              "categoryUrl": {
                "label": "Category",
                "format": "text"
              },
              "productId": {
                "label": "Product",
                "format": "text"
              },
              "error": {
                "label": "Error",
                "format": "text"
              },
              "errorStep": {
                "label": "Step",
                "format": "text"
              },
              "httpStatus": {
                "label": "HTTP",
                "format": "number"
              },
              "blocked": {
                "label": "Anti-bot block",
                "format": "boolean"
              },
              "blockMarkers": {
                "label": "Detected",
                "format": "array"
              }
            }
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}