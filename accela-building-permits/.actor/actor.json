          "transformation": {
            "fields": [
              "agency",
              "recordNumber",
              "recordType",
              "category",
              "status",
              "openedDate",
              "address",
              "city",
              "zip",
              "description",
              "valuation",
              "contractorName",
              "detailUrl"
            ]
          },
