    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/egra_van~document-to-markdown/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ urls: $('Add documents form').first().json['Document links'].split(/\\s+/).filter(u => u.startsWith('http')).map(url => ({ url })), outputFormat: 'markdown', chunking: 'heading', chunkSize: $json.chunkSizeTokens, chunkSizeUnit: 'tokens', chunkOverlap: 30, includePageNumbers: true, ocr: $json.ocrScannedPdfs }) }}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "c5d895e9-3ba1-4eeb-a80c-9c3b26661159",
      "name": "Convert to Markdown chunks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Apify API token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// One item per chunk, ready for the vector store.\nreturn $input.all()\n  .filter(i => i.json.status !== 'failed' && i.json.text)\n  .map(i => ({ json: {\n    text: i.json.text,\n    source: i.json.fileName || i.json.sourceUrl || '',\n    page: i.json.metadata?.pageStart ?? '',\n    heading: i.json.metadata?.headingPath ?? '',\n  } }));"
      },
      "id": "fe84eb1f-645e-442c-8f6a-204218437df5",
      "name": "Prepare chunks",
