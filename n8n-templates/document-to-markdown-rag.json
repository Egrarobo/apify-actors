{
  "name": "Chat with PDF, Word and PowerPoint files using Apify Document to Markdown and OpenAI",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Add documents to the knowledge base",
        "formDescription": "Paste links to PDF, Word, PowerPoint or Excel files (one per line). Each file is converted to Markdown, split into chunks and stored for the AI assistant.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Document links",
              "fieldType": "textarea",
              "requiredField": true,
              "placeholder": "https://example.com/handbook.pdf"
            }
          ]
        },
        "options": {
          "appendAttribution": false
        }
      },
      "id": "a56cbde8-7ed7-43f6-8cb8-0ae42b6b187b",
      "name": "Add documents form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        200
      ],
      "webhookId": "66e74c50-1a40-4ae9-9582-fe27800001a5"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/egra_van~document-to-markdown/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ urls: $json['Document links'].split(/\\s+/).filter(u => u.startsWith('http')).map(url => ({ url })), outputFormat: 'markdown', chunking: 'heading', chunkSize: 250, chunkSizeUnit: 'tokens', chunkOverlap: 30, includePageNumbers: true, ocr: true }) }}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "52008db2-3fa9-4700-8832-2ed07f5fd58c",
      "name": "Convert to Markdown chunks (Apify)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Apify API token (Header Auth)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// One item per chunk, ready for the vector store.\nreturn $input.all()\n  .filter(i => i.json.status !== 'failed' && i.json.text)\n  .map(i => ({ json: {\n    text: i.json.text,\n    source: i.json.fileName || i.json.sourceUrl || '',\n    page: i.json.metadata?.pageStart ?? '',\n    heading: i.json.metadata?.headingPath ?? '',\n  } }));"
      },
      "id": "31f449a9-d324-4276-a43c-7b223ab4ac76",
      "name": "Prepare chunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        200
      ]
    },
