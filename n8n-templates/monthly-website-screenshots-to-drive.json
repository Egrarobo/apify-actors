    {
      "parameters": {
        "jsCode": "// One row per run\nconst run = $('Take screenshots').first().json;\nconst file = $input.first().json;\nreturn [{ json: {\n  date: new Date().toISOString().slice(0, 10),\n  pages: run.totalUrls,\n  saved: run.succeeded,\n  failed: (run.failed || 0) + (run.invalidUrls || 0),\n  zipInDrive: file.id ? `https://drive.google.com/file/d/${file.id}/view` : '',\n  apifyResults: run.resultsUrl || '',\n} }];"
      },
