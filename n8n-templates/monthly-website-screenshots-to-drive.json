    {
      "parameters": {
        "jsCode": "// Collect the URLs from the sheet into one Apify input\nconst urls = $input.all()\n  .map(i => String(i.json.url || '').trim())\n  .filter(u => /^https?:\\/\\//i.test(u));\nif (!urls.length) throw new Error('No URLs found. Put the pages in a column named \"url\".');\nconst s = $('Settings').first().json;\nreturn [{ json: { actorInput: {\n  urls,\n  fullPage: true,\n  device: s.device,\n  format: s.format,\n  quality: 80,\n  savePdf: s.savePdf,\n  hideCookieBanners: true,\n  blockAds: true,\n  outputZip: true,\n} } }];"
      },
      "id": "cd6903c6-b2aa-4717-aa74-0a44463047e1",
      "name": "Collect URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
