{
  "actorSpecification": 1,
  "name": "google-hotels-prices",
  "title": "Google Hotels Prices API & Scraper: Rate Parity",
  "description": "Google Hotels prices API and scraper for daily hotel price tracking and rate parity checks: per night and per stay, taxes, rating, stars and, optionally, every booking site's rate (Booking.com, Expedia, official site) for your hotels and fixed dates. $3 / 1,000 hotels, +$2 with rates.",
  "version": "1.0",
  "buildTag": "latest",
  "defaultMemoryMbytes": 1024,
  "minMemoryMbytes": 512,
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "fields": {},
      "views": {
        "overview": {
          "title": "Hotels",
          "transformation": {
            "fields": [
              "thumbnail",
              "hotelName",
              "priceLowest",
              "pricePerNight",
              "pricePerNightWithTaxes",
              "currency",
              "rating",
              "reviews",
              "hotelClass",
              "dealLabel",
              "cheapestProvider",
              "offersCount",
              "checkIn",
              "checkOut",
              "query",
              "url"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "thumbnail": {
                "label": "Photo",
                "format": "image"
              },
              "hotelName": {
                "label": "Hotel",
                "format": "text"
              },
              "priceLowest": {
                "label": "Lowest price / night",
                "format": "number"
              },
              "pricePerNight": {
                "label": "Google price / night",
                "format": "number"
              },
              "pricePerNightWithTaxes": {
                "label": "With taxes / night",
                "format": "number"
              },
              "currency": {
                "label": "Currency",
                "format": "text"
              },
              "rating": {
                "label": "Rating",
                "format": "number"
              },
              "reviews": {
                "label": "Reviews",
                "format": "number"
              },
              "hotelClass": {
                "label": "Stars",
                "format": "number"
              },
              "dealLabel": {
                "label": "Deal",
                "format": "text"
              },
              "cheapestProvider": {
                "label": "Cheapest site",
                "format": "text"
              },
              "offersCount": {
                "label": "Offers",
                "format": "number"
              },
              "checkIn": {
                "label": "Check-in",
                "format": "date"
              },
              "checkOut": {
                "label": "Check-out",
                "format": "date"
              },
              "query": {
                "label": "Search",
                "format": "text"
              },
              "url": {
                "label": "Google Hotels",
                "format": "link"
              }
            }
          }
        },
        "offers": {
          "title": "Booking site offers",
          "transformation": {
            "fields": [
              "hotelName",
              "priceLowest",
              "cheapestProvider",
              "officialSitePrice",
              "currency",
              "offersCount",
              "offers",
              "url"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "hotelName": {
                "label": "Hotel",
                "format": "text"
              },
              "priceLowest": {
                "label": "Lowest / night",
                "format": "number"
              },
              "cheapestProvider": {
                "label": "Cheapest site",
                "format": "text"
              },
              "officialSitePrice": {
                "label": "Official site / night",
                "format": "number"
              },
              "currency": {
                "label": "Currency",
                "format": "text"
              },
              "offersCount": {
                "label": "Offers",
                "format": "number"
              },
              "offers": {
                "label": "All offers",
                "format": "array"
              },
              "url": {
                "label": "Google Hotels",
                "format": "link"
              }
            }
          }
        },
        "location": {
          "title": "Location & details",
          "transformation": {
            "fields": [
              "hotelName",
              "address",
              "lat",
              "lng",
              "hotelClassText",
              "website",
              "phone",
              "checkInTime",
              "checkOutTime",
              "amenities",
              "googleMapsUrl"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "hotelName": {
                "label": "Hotel",
                "format": "text"
              },
              "address": {
                "label": "Address",
                "format": "text"
              },
              "lat": {
                "label": "Latitude",
                "format": "number"
              },
              "lng": {
                "label": "Longitude",
                "format": "number"
              },
              "hotelClassText": {
                "label": "Class",
                "format": "text"
              },
              "website": {
                "label": "Website",
                "format": "link"
              },
              "phone": {
                "label": "Phone",
                "format": "text"
              },
              "checkInTime": {
                "label": "Check-in time",
                "format": "text"
              },
              "checkOutTime": {
                "label": "Check-out time",
                "format": "text"
              },
              "amenities": {
                "label": "Amenities",
                "format": "array"
              },
              "googleMapsUrl": {
                "label": "Google Maps",
                "format": "link"
              }
            }
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}