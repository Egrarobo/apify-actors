{
  "actorSpecification": 1,
  "name": "google-trends",
  "title": "Google Trends Scraper & API",
  "description": "Google Trends scraper and API with fast, bounded runs: interest over time by country, region or city, top and rising searches and Trending Now, as JSON, CSV or Excel. Fixed retries and time limits, so runs end instead of hanging. $3 / 1,000 keywords, $1 / 1,000 trending; failed ones free.",
  "version": "1.0",
  "buildTag": "latest",
  "defaultMemoryMbytes": 1024,
  "minMemoryMbytes": 512,
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "fields": {},
      "views": {
        "overview": {
          "title": "Terms overview",
          "transformation": {
            "fields": [
              "type",
              "term",
              "title",
              "status",
              "averageInterest",
              "comparableAverage",
              "latestValue",
              "peakValue",
              "peakDate",
              "topRegion",
              "comparedWith",
              "geo",
              "timeRange",
              "categoryName",
              "gpropName",
              "errors",
              "exploreUrl"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "type": {
                "label": "Type",
                "format": "text"
              },
              "term": {
                "label": "Term",
                "format": "text"
              },
              "title": {
                "label": "Trending search",
                "format": "text"
              },
              "status": {
                "label": "Status",
                "format": "text"
              },
              "averageInterest": {
                "label": "Average interest",
                "format": "number"
              },
              "comparableAverage": {
                "label": "Comparable average (anchor)",
                "format": "number"
              },
              "latestValue": {
                "label": "Latest",
                "format": "number"
              },
              "peakValue": {
                "label": "Peak",
                "format": "number"
              },
              "peakDate": {
                "label": "Peak date",
                "format": "text"
              },
              "topRegion": {
                "label": "Top region",
                "format": "text"
              },
              "comparedWith": {
                "label": "Compared with",
                "format": "array"
              },
              "geo": {
                "label": "Location",
                "format": "text"
              },
              "timeRange": {
                "label": "Time range",
                "format": "text"
              },
              "categoryName": {
                "label": "Category",
                "format": "text"
              },
              "gpropName": {
                "label": "Property",
                "format": "text"
              },
              "errors": {
                "label": "Errors",
                "format": "array"
              },
              "exploreUrl": {
                "label": "Google Trends",
                "format": "link"
              }
            }
          }
        },
        "timeline": {
          "title": "Interest over time",
          "transformation": {
            "fields": [
              "term",
              "groupId",
              "resolution",
              "timeRangeResolved",
              "averageInterest",
              "latestValue",
              "latestDate",
              "timelinePoints",
              "timeline"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "term": {
                "label": "Term",
                "format": "text"
              },
              "groupId": {
                "label": "Group",
                "format": "number"
              },
              "resolution": {
                "label": "Resolution",
                "format": "text"
              },
              "timeRangeResolved": {
                "label": "Period",
                "format": "text"
              },
              "averageInterest": {
                "label": "Average",
                "format": "number"
              },
              "latestValue": {
                "label": "Latest",
                "format": "number"
              },
              "latestDate": {
                "label": "Latest date",
                "format": "text"
              },
              "timelinePoints": {
                "label": "Points",
                "format": "number"
              },
              "timeline": {
                "label": "Timeline",
                "format": "array"
              }
            }
          }
        },
        "regions": {
          "title": "Interest by region",
          "transformation": {
            "fields": [
              "term",
              "geo",
              "regionResolution",
              "topRegion",
              "regions"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "term": {
                "label": "Term",
                "format": "text"
              },
              "geo": {
                "label": "Location",
                "format": "text"
              },
              "regionResolution": {
                "label": "Level",
                "format": "text"
              },
              "topRegion": {
                "label": "Top region",
                "format": "text"
              },
              "regions": {
                "label": "Regions",
                "format": "array"
              }
            }
          }
        },
        "related": {
          "title": "Related queries & topics",
          "transformation": {
            "fields": [
              "term",
              "relatedQueriesTop",
              "relatedQueriesRising",
              "relatedTopicsTop",
              "relatedTopicsRising"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "term": {
                "label": "Term",
                "format": "text"
              },
              "relatedQueriesTop": {
                "label": "Top queries",
                "format": "array"
              },
              "relatedQueriesRising": {
                "label": "Rising queries",
                "format": "array"
              },
              "relatedTopicsTop": {
                "label": "Top topics",
                "format": "array"
              },
              "relatedTopicsRising": {
                "label": "Rising topics",
                "format": "array"
              }
            }
          }
        },
        "trending": {
          "title": "Trending now",
          "transformation": {
            "fields": [
              "rank",
              "title",
              "approxTraffic",
              "increasePercent",
              "startedAt",
              "isActive",
              "categories",
              "newsTitle",
              "newsUrl",
              "newsSource",
              "picture",
              "geo",
              "exploreUrl"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "rank": {
                "label": "Rank",
                "format": "number"
              },
              "title": {
                "label": "Trending search",
                "format": "text"
              },
              "approxTraffic": {
                "label": "Searches",
                "format": "text"
              },
              "increasePercent": {
                "label": "Growth %",
                "format": "number"
              },
              "startedAt": {
                "label": "Started",
                "format": "date"
              },
              "isActive": {
                "label": "Active",
                "format": "boolean"
              },
              "categories": {
                "label": "Categories",
                "format": "array"
              },
              "newsTitle": {
                "label": "Top news",
                "format": "text"
              },
              "newsUrl": {
                "label": "News link",
                "format": "link"
              },
              "newsSource": {
                "label": "News source",
                "format": "text"
              },
              "picture": {
                "label": "Picture",
                "format": "image"
              },
              "geo": {
                "label": "Country",
                "format": "text"
              },
              "exploreUrl": {
                "label": "Google Trends",
                "format": "link"
              }
            }
          }
        },
        "flat": {
          "title": "Flat rows (spreadsheet mode)",
          "transformation": {
            "fields": [
              "rowType",
              "term",
              "date",
              "value",
              "comparableValue",
              "isPartial",
              "regionName",
              "regionCode",
              "list",
              "rank",
              "query",
              "title",
              "formattedValue",
              "geo",
              "timeRange"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "rowType": {
                "label": "Row type",
                "format": "text"
              },
              "term": {
                "label": "Term",
                "format": "text"
              },
              "date": {
                "label": "Date",
                "format": "text"
              },
              "value": {
                "label": "Value",
                "format": "number"
              },
              "comparableValue": {
                "label": "Comparable value",
                "format": "number"
              },
              "isPartial": {
                "label": "Partial",
                "format": "boolean"
              },
              "regionName": {
                "label": "Region",
                "format": "text"
              },
              "regionCode": {
                "label": "Region code",
                "format": "text"
              },
              "list": {
                "label": "List",
                "format": "text"
              },
              "rank": {
                "label": "Rank",
                "format": "number"
              },
              "query": {
                "label": "Query",
                "format": "text"
              },
              "title": {
                "label": "Topic",
                "format": "text"
              },
              "formattedValue": {
                "label": "Formatted",
                "format": "text"
              },
              "geo": {
                "label": "Location",
                "format": "text"
              },
              "timeRange": {
                "label": "Time range",
                "format": "text"
              }
            }
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}
